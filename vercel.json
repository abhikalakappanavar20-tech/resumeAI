{
    "version": 2,
    "installCommand": "pip install --no-compile --no-cache-dir -r requirements-vercel.txt",
    "buildCommand": "python manage.py collectstatic --noinput",
    "builds": [
        {
            "src": "vercel_app/index.py",
            "use": "@vercel/python",
            "config": {
                "maxDuration": 30
            }
        }
    ],
    "routes": [
        {
            "src": "/(.*)",
            "dest": "vercel_app/index.py"
        }
    ]
}
